[Unit]
Description=Refresh xray-waybar geo lists daily

[Timer]
# Первый прогон через 2 минуты после загрузки ИЛИ через 2 минуты после
# активации таймера (на случай переустановки в середине сессии когда
# OnBootSec уже в прошлом — без OnActiveSec= таймер залипал бы пустым).
# Дальше раз в сутки.
#
# Persistent= здесь не работает — он действует только с OnCalendar=,
# не с monotonic-анкерами.
OnBootSec=2min
OnActiveSec=2min
OnUnitActiveSec=24h
AccuracySec=1m
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
