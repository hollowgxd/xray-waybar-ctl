[Unit]
Description=Run xray-waybar TCP liveness check every 30 seconds

[Timer]
# First run shortly after boot OR shortly after the timer itself becomes
# active (covers reinstall / `systemctl --user daemon-reload` mid-session
# when OnBootSec is already past). After that, every 30 seconds.
#
# Persistent= deliberately omitted — it only works with OnCalendar=, not
# with these monotonic anchors. Without OnActiveSec= the timer can sit
# active-but-idle forever waiting for the service to first run.
OnBootSec=15s
OnActiveSec=15s
OnUnitActiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target
